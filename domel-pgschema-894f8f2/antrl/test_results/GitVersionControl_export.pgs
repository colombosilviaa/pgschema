CREATE GRAPH TYPE GitVersionControl STRICT {
    (userType: User {email STRING}),
    (commitType: Commit {hash STRING, authorEmail STRING}),
    (fileType: File {path STRING}),
    (:userType)-[authorsType: Authors]->(:commitType),
    (:commitType)-[Action: Adds|Deletes|Modifies {lines INT}]->(:fileType),
    FOR (x: userType) EXCLUSIVE x.email,
    FOR (x: userType) MANDATORY y.authorEmail WITHIN (y: commitType) WHERE y.authorEmail = x.email,
    FOR (x: commitType) EXCLUSIVE MANDATORY SINGLETON x.hash
}
