CREATE GRAPH TYPE CorporateHierarchy STRICT {
    (employeeType: Employee {empId INT, email STRING, age INT}),
    (managerType: employeeType & Manager {departmentId INT}),
    (internType: employeeType & Intern {mentorId INT}),
    (departmentType: Department {deptId INT, name STRING}),
    (:employeeType)-[worksinType: Worksin]->(:departmentType),
    (:internType)-[mentoredbyType: Mentoredby]->(:managerType),
    FOR (x: employeeType) EXCLUSIVE MANDATORY SINGLETON x.empId,
    FOR (x: employeeType) EXCLUSIVE x.email,
    FOR (x: employeeType) MANDATORY x.age >= 18,
    FOR (x: employeeType) MANDATORY x.age <= 65,
    FOR (x: managerType) MANDATORY (x: !internType),
    FOR (x: managerType) MANDATORY y.deptId WITHIN (y: departmentType) WHERE y.deptId = x.departmentId,
    FOR (x: employeeType) MANDATORY SINGLETON y WITHIN (x)-[y: worksInType]->()
}
