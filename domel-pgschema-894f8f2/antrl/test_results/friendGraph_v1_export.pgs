CREATE GRAPH TYPE friendGraph_v1 STRICT {
    (personType: Person {name STRING, OPTIONAL bday DATE, OPEN}),
    (customerType: Customer),
    (:personType)-[friendType: Knows & Likes {OPTIONAL since DATE}]->(:personType),
    (:personType)-[friendType: Knows & Likes {OPTIONAL since DATE}]->(:customerType),
    (:customerType)-[friendType: Knows & Likes {OPTIONAL since DATE}]->(:customerType)
}
